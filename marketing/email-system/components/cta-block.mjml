<mj-section background-color="#ffffff" padding="44px 48px" border-top="1px solid #e8e4dc">
  <mj-column>
    <mj-text align="center" font-family="'Noto Serif Display', Georgia, serif" font-size="22px" font-weight="600" color="#1b4332" line-height="1.3" padding-bottom="12px">
      Not sure which blend is right for you?
    </mj-text>
    <mj-text align="center" font-family="Inter, Arial, sans-serif" font-size="14px" color="#6c757d" line-height="1.6" padding-bottom="24px">
      Our seed specialists match you to the right product<br/>
      for your soil, region, and goals — for free.
    </mj-text>
    <mj-button
      align="center"
      background-color="transparent"
      color="#2d6a4f"
      border="2px solid #2d6a4f"
      border-radius="2px"
      font-family="Inter, Arial, sans-serif"
      font-size="13px"
      font-weight="600"
      letter-spacing="0.04em"
      text-transform="uppercase"
      inner-padding="13px 28px"
      href="https://naturesseed.com/pages/seed-selector"
    >
      Ask a Seed Expert
    </mj-button>
  </mj-column>
</mj-section>
